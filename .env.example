VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_HEY_API_URL=https://your-project.supabase.co/functions/v1/hey

# Set these as Supabase Edge Function secrets, not Vite variables.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
APP_URL=http://localhost:5173

# Optional Studio endpoint; otherwise derived from VITE_SUPABASE_URL.
# VITE_HEY_STUDIO_URL=https://your-project.supabase.co/functions/v1/hey-studio
# Server secrets only (set in Supabase Dashboard):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=flux
# LUMA_API_KEY=
# LUMA_VIDEO_MODEL=ray-2

# DeepSeek V4.1 Flash (free tier available). Add your key here to enable
# DeepSeek-powered chat, reasoning, and coding. Model: deepseek-flash
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Web Push (VAPID). The PUBLIC key is safe for the client build; the PRIVATE
# key and subject must ONLY be set as Supabase Edge Function secrets for the
# `hey-push` function (VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT).
# Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
