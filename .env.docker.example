# Docker Environment Variables
# Copy this to .env and fill in your values

# Database
POSTGRES_USER=hey
POSTGRES_PASSWORD=secure_random_password_here
POSTGRES_DB=hey

# Auth
AUTH_SECRET=your-super-secret-key-min-32-chars-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_TEAM_YEARLY=price_xxxxxxxxxxxx

# AI Providers
OPENAI_API_KEY=sk-xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Email
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_xxxxxxxxxxxx
EMAIL_FROM=HEY <noreply@your-domain.com>

# Monitoring
SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxxxx
VERCEL_ANALYTICS_ID=xxxxxxxx

# Feature Flags
FEATURE_AI_CHAT=true
FEATURE_VOICE_INPUT=false
FEATURE_FILE_UPLOAD=false
FEATURE_TEAM_WORKSPACES=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Backup
BACKUP_S3_BUCKET=hey-backups
BACKUP_S3_REGION=us-east-1
BACKUP_AWS_ACCESS_KEY_ID=xxxxxxxx
BACKUP_AWS_SECRET_ACCESS_KEY=xxxxxxxx